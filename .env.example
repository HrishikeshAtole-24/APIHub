# ─────────────────────────────────────────────────────────────
#  APIHub — environment configuration
#  Copy to `.env` at the repo root:  cp .env.example .env
#  Every value below has a working default for LOCAL development.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────
# DATABASE_DRIVER: pglite | neon | postgres   (default: pglite)
#
#   pglite   → embedded PostgreSQL (WASM). Zero setup, stored in .data/.
#              Perfect for local dev; no Docker, no server, no install.
#   neon     → Neon serverless PostgreSQL over HTTP. Production.
#   postgres → any standard PostgreSQL via TCP (node-postgres).
#
# Leave DATABASE_URL empty to use pglite.
DATABASE_DRIVER=pglite
DATABASE_URL=

# ── Neon (production) ────────────────────────────────────────
# Copy BOTH strings from the Neon dashboard and uncomment:
#
#   DATABASE_DRIVER=neon
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/apihub?sslmode=require
#   DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/apihub?sslmode=require
#
# DATABASE_URL should be the POOLED string (host contains "-pooler").
# DATABASE_URL_UNPOOLED must be the DIRECT one: Neon requires a non-pooled
# connection for migrations, and `pnpm db:migrate` uses it automatically.
DATABASE_URL_UNPOOLED=
PGLITE_DATA_DIR=.data/pglite

# PGlite is SINGLE-WRITER: only one process may open the data directory. With
# it, the API hosts background jobs in-process and `pnpm dev` skips the separate
# worker. Set WORKER_STANDALONE=true (with the API stopped) to run the worker
# against the embedded database anyway.
# WORKER_STANDALONE=false

# ── Cache / Queue ────────────────────────────────────────────
# Leave REDIS_URL empty to use the in-memory LRU cache + in-process
# scheduler. Set it to enable Redis caching, distributed rate limiting,
# distributed locks and durable BullMQ queues.
REDIS_URL=
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=apihub

# ── API server ───────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────
# MUST be >=32 chars and MUST be changed for any real deployment.
AUTH_SECRET=dev-only-insecure-secret-change-me-please-32chars
SESSION_TTL_SECONDS=604800
COOKIE_NAME=apihub_session
COOKIE_DOMAIN=
COOKIE_SECURE=false

# ── Playground (SSRF boundary) ───────────────────────────────
PLAYGROUND_TIMEOUT_MS=10000
PLAYGROUND_MAX_RESPONSE_BYTES=2097152
PLAYGROUND_MAX_REDIRECTS=3
PLAYGROUND_ALLOW_HTTP=false
# Comma-separated hostname allowlist. Empty = allow any PUBLIC host
# (private/loopback/link-local/metadata ranges are ALWAYS blocked).
PLAYGROUND_HOST_ALLOWLIST=

# ── Health monitoring ────────────────────────────────────────
HEALTH_PROBE_TIMEOUT_MS=8000
HEALTH_PROBE_CONCURRENCY=8
HEALTH_SCHEDULE_INTERVAL_MS=300000
HEALTH_DEGRADED_LATENCY_MS=1500
HEALTH_RETENTION_DAYS=90

# ── Ingestion ────────────────────────────────────────────────
INGESTION_SOURCE_URL=https://raw.githubusercontent.com/public-apis/public-apis/master/README.md
INGESTION_USER_AGENT=APIHub-Ingestion/0.1 (+https://github.com/HrishikeshAtole-24/APIHub)

# ── Rate limits (requests per window) ────────────────────────
RATE_LIMIT_IP_PER_MIN=100
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_SEARCH_PER_MIN=60
RATE_LIMIT_PLAYGROUND_PER_MIN=10
# Keep these low: they protect credential guessing and privileged actions.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
RATE_LIMIT_ADMIN_PER_MIN=30

# ── AI (optional; platform degrades gracefully without it) ───
# Anthropic API key enables the grounded AI assistant + embeddings.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_ENABLED=false

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
