{
  "name": "@apihub/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:reset": "tsx src/cli/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "@apihub/config": "workspace:*",
    "@apihub/logger": "workspace:*",
    "@apihub/algorithms": "workspace:*",
    "@apihub/security": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "@electric-sql/pglite": "^0.5.7",
    "@neondatabase/serverless": "^1.1.0",
    "pg": "^8.23.0",
    "@types/pg": "^8.15.6"
  },
  "peerDependencies": {
    "@electric-sql/pglite": "*",
    "@neondatabase/serverless": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "@neondatabase/serverless": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
