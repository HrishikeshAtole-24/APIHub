{
  "name": "apihub",
  "version": "0.1.0",
  "private": true,
  "description": "APIHub - Discover, test, compare and monitor public APIs.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @apihub/web test:e2e",
    "db:generate": "pnpm --filter @apihub/database db:generate",
    "db:migrate": "pnpm --filter @apihub/database db:migrate",
    "db:seed": "pnpm --filter @apihub/database db:seed",
    "db:studio": "pnpm --filter @apihub/database db:studio",
    "ingest": "pnpm --filter @apihub/worker ingest",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "turbo": "^2.10.11",
    "typescript": "5.9.3"
  }
}
